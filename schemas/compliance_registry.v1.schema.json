{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compliance_registry.v1.schema.json",
  "title": "compliance_registry.v1",
  "description": "Validates schemas/compliance_registry.v1.json. Every consumer (the Builder's scoping skill, the compliance authority) validates the registry at startup, and additionally rejects a stage that lists a criterion twice, which JSON Schema cannot express. An invalid registry is rejected, not repaired.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "contracts"
  ],
  "properties": {
    "schema_version": {
      "const": "compliance_registry.v1"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "contracts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stages"
        ],
        "properties": {
          "stages": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "DESIGN_REVIEW",
                "IMPLEMENTATION_AUDIT",
                "PRODUCTION_READINESS"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criteria"
              ],
              "properties": {
                "criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "criterion_id",
                      "title",
                      "mandatory",
                      "min_evidence_tier"
                    ],
                    "properties": {
                      "criterion_id": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}-[0-9]{3}$"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "mandatory": {
                        "const": true
                      },
                      "min_evidence_tier": {
                        "enum": [
                          "ABSENT",
                          "CLAIMED",
                          "OBSERVED",
                          "VERIFIED"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
