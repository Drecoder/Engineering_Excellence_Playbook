{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "features.v1",
  "title": "Unit Features",
  "description": "rig's deterministic feature record for one unit (a changed function or IaC block, in the accept or reject lane). The complexity assessor reads only this, never raw code. Every value is computed by code; none comes from a model. A feature rig could not compute is listed in missing, and the assessor fails closed on it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unit_id", "lane", "repo", "sha", "language", "diff", "structure", "missing"],
  "properties": {
    "schema_version": { "const": "features.v1" },
    "unit_id": { "type": "string" },
    "lane": { "type": "string", "enum": ["accept", "reject"] },
    "repo": { "type": "string" },
    "sha": { "type": "string" },
    "language": { "type": "string", "enum": ["typescript", "python", "go", "hcl"] },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines_added", "lines_removed", "hunks", "file_kind"],
      "properties": {
        "lines_added": { "type": "integer", "minimum": 0 },
        "lines_removed": { "type": "integer", "minimum": 0 },
        "hunks": { "type": "integer", "minimum": 0 },
        "file_kind": { "type": "string", "enum": ["code", "test", "iac", "config", "docs"] },
        "sensitive_paths": { "type": "array", "items": { "type": "string", "enum": ["auth", "iam", "crypto", "logging", "telemetry", "secrets"] }, "uniqueItems": true },
        "new_dependencies": { "type": "integer", "minimum": 0 },
        "tests_changed_with_code": { "type": "boolean" }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "fan_in", "fan_out"],
      "properties": {
        "symbol": { "type": "string" },
        "visibility": { "type": "string", "enum": ["internal", "shared"] },
        "fan_in": { "type": "integer", "minimum": 0 },
        "fan_out": { "type": "integer", "minimum": 0 },
        "cognitive_complexity_before": { "type": "integer", "minimum": 0 },
        "cognitive_complexity_after": { "type": "integer", "minimum": 0 },
        "boundary_crossings": { "type": "integer", "minimum": 0 },
        "contracts_touched": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "touches": {
          "type": "array",
          "description": "What the unit touches, from the closed vocabulary in architecture_rules.v1 touches. Selects which ARCH-* rules run and which lens asks reach the prompt.",
          "items": {
            "type": "string",
            "enum": ["module_import", "new_deployable", "db_access", "db_transaction", "migration", "contract", "queue_definition", "queue_publish", "queue_consume", "http_client", "list_endpoint", "cache"]
          },
          "uniqueItems": true
        },
        "implicit_state": {
          "type": "array",
          "items": { "type": "string", "enum": ["async_fanout", "goroutine", "channel", "mutex", "retry", "cache", "module_state"] },
          "uniqueItems": true
        },
        "iac_proxies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "for_each_or_count": { "type": "integer", "minimum": 0 },
            "dynamic_blocks": { "type": "integer", "minimum": 0 },
            "conditionals": { "type": "integer", "minimum": 0 },
            "resources_changed": { "type": "integer", "minimum": 0 }
          }
        },
        "untested": { "type": "boolean", "description": "The changed symbol has no test reaching it." }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_passed": { "type": "boolean" },
        "changed_line_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "flaky_tests_involved": { "type": "boolean" },
        "build_failure_ref": { "type": "string", "description": "Reject lane: id of the build_failure.v1 record." }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "incidents_on_path": { "type": "integer", "minimum": 0 },
        "past_findings": { "type": "integer", "minimum": 0 },
        "author_kind": { "type": "string", "enum": ["human", "builder", "third_party_agent"] }
      }
    },
    "rule_findings": {
      "type": "array",
      "description": "Deterministic rule hits: reuse rules (clones, boundary violations, contract copies, string-contract collisions) and ARCH-* rules from architecture_rules.v1.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "blocking"],
        "properties": {
          "rule": {
            "anyOf": [
              { "type": "string", "enum": ["exact_clone", "near_clone", "illegal_boundary_import", "contract_copy", "string_contract_collision"] },
              { "type": "string", "pattern": "^ARCH-[0-9]{3}$" }
            ]
          },
          "blocking": { "type": "boolean" },
          "reuse_ref": { "type": "string", "description": "Matching symbol_index entry (path#name), when the rule found one." },
          "source": { "type": "string", "enum": ["static", "trace"], "description": "ARCH-* hits: which check found it." },
          "result": {
            "type": "string",
            "enum": ["violation", "unverifiable"],
            "description": "unverifiable: a span the check needed lacked a required attribute. It is reported, never counted as compliant, and does not block."
          },
          "location": { "type": "string", "description": "Static hits: path:line." },
          "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$", "description": "Trace hits: the test-run trace that shows the violation." },
          "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
        },
        "allOf": [
          { "if": { "properties": { "source": { "const": "trace" } }, "required": ["source"] }, "then": { "properties": { "trace_id": true, "span_id": true, "result": true }, "required": ["trace_id", "span_id", "result"] } },
          { "if": { "properties": { "source": { "const": "static" } }, "required": ["source"] }, "then": { "properties": { "location": true, "result": true }, "required": ["location", "result"] } }
        ]
      }
    },
    "missing": {
      "type": "array",
      "description": "Features rig could not compute (e.g. stale index, parse failure, Sonar conformance mismatch). Non-empty means the assessor fails closed.",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
